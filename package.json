{
  "name": "isitpeak",
  "displayName": "IsItPeak?",
  "description": "通用的峰谷价标识插件",
  "version": "0.0.0",
  "publisher": "debug967",
  "repository": "https://github.com/lidongxun967/IsItPeak",
  "engines": {
    "vscode": "^1.125.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "configuration": {
      "title": "IsItPeak",
      "properties": {
        "isitpeak.peakPeriods": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "start": {
                "type": "string",
                "description": "开始时间（24 小时制，如 08:00）"
              },
              "end": {
                "type": "string",
                "description": "结束时间（24 小时制，如 11:00；若小于开始时间则视为跨天）"
              },
              "days": {
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 6
                },
                "description": "该时段生效的星期（0=周日、1=周一、……、6=周六）；省略或为空则每天生效"
              },
              "freeOnHolidays": {
                "type": "boolean",
                "default": false,
                "description": "法定节假日全天按空闲时段计费：开启后，该时段在 isitpeak.holidayData 配置的日期内不生效（调休上班的周末本就属于周末，无需添加）"
              }
            },
            "required": [
              "start",
              "end"
            ]
          },
          "default": [
            {
              "start": "09:00",
              "end": "12:00",
              "days": [1, 2, 3, 4, 5],
              "freeOnHolidays": true
            },
            {
              "start": "14:00",
              "end": "18:00",
              "days": [1, 2, 3, 4, 5],
              "freeOnHolidays": true
            }
          ],
          "description": "峰价时段列表，支持多个时段与跨天（如 22:00 至 06:00）"
        },
        "isitpeak.holidayData": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^\\d{1,2}\\.\\d{1,2}$"
            },
            "description": "该年份的日期列表，格式为 \"月.日\"（如 \"1.1\"）"
          },
          "default": {
            "2026": [
              "1.1", "1.2", "1.3",
              "2.15", "2.16", "2.17", "2.18", "2.19", "2.20", "2.21", "2.22", "2.23",
              "4.4", "4.5", "4.6",
              "5.1", "5.2", "5.3", "5.4", "5.5",
              "6.19", "6.20", "6.21",
              "9.25", "9.26", "9.27",
              "10.1", "10.2", "10.3", "10.4", "10.5", "10.6", "10.7"
            ]
          },
          "description": "节假日数据，可按年调整：年份 -> 法定节假日日期列表，这些日期在开启了 freeOnHolidays 的峰价时段内全天按空闲计费（调休上班的周末无需添加，其本就属于周末）"
        },
        "isitpeak.peakLabel": {
          "type": "string",
          "default": "峰价",
          "description": "处于峰价时段时状态栏显示的文字"
        },
        "isitpeak.valleyLabel": {
          "type": "string",
          "default": "谷价",
          "description": "非峰价时段时状态栏显示的文字"
        },
        "isitpeak.notifyOnSwitch": {
          "type": "boolean",
          "default": true,
          "description": "状态在峰价/谷价之间切换时是否弹出通知"
        },
        "isitpeak.showRemaining": {
          "type": "boolean",
          "default": true,
          "description": "是否在状态栏直接显示当前状态剩余时长（精确到分钟，如「峰价还剩2小时30分钟」）"
        },
        "isitpeak.peakYellowBackground": {
          "type": "boolean",
          "default": true,
          "description": "处于峰价时段时是否使用黄色背景高亮状态栏"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "pnpm run package",
    "compile": "pnpm run check-types && pnpm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "pnpm run check-types && pnpm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "pnpm run compile-tests && pnpm run compile && pnpm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "@types/vscode": "^1.125.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.28.1",
    "eslint": "^10.5.0",
    "npm-run-all": "^4.1.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}
